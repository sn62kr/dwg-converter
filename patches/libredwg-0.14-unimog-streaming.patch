+/* UNIMOG patch: postponed names are resolved one per entity, and each
+   lookup walked the whole table through dynapi (190k entities: seconds).
+   Same name, same table, same answer: remember it for this pass. */
+typedef struct
+{
+  char *key;
+  BITCODE_H hdl;
+} TableHandleSlot;
+static TableHandleSlot *th_slots;
+static size_t th_cap, th_n;
+
+static void
+tablehandle_cache_reset (void)
+{
+  for (size_t i = 0; i < th_cap; i++)
+    free (th_slots[i].key);
+  free (th_slots);
+  th_slots = NULL;
+  th_cap = th_n = 0;
+}
+
+static size_t
+th_hash (const char *k)
+{
+  uint64_t h = 1469598103934665603ULL;
+  for (; *k; k++)
+    h = (h ^ (unsigned char)*k) * 1099511628211ULL;
+  return (size_t)h;
+}
+
+/* UNIMOG patch: DXF writers may give the BLOCK_RECORD table a smaller
+   entry count (70) than the records it holds (ODA: only the named ones),
+   and the control object then lists only that many: an INSERT of an
+   anonymous block (*U2) found nothing and its drawing was lost. Look
+   through all block headers by name instead. */
+static BITCODE_H
+block_by_name_scan (Dwg_Data *restrict dwg, const char *name)
+{
+  for (BITCODE_BL i = 0; i < dwg->num_objects; i++)
+    {
+      Dwg_Object *o = &dwg->object[i];
+      char *nm = NULL;
+      int isnew = 0;
+      if (o->fixedtype != DWG_TYPE_BLOCK_HEADER || !o->tio.object
+          || !o->tio.object->tio.BLOCK_HEADER)
+        continue;
+      if (dwg_dynapi_entity_utf8text (o->tio.object->tio.BLOCK_HEADER,
+                                      o->name, "name", &nm, &isnew, NULL)
+          && nm && !strcasecmp (nm, name))
+        {
+          if (isnew)
+            free (nm);
+          return dwg_add_handleref (dwg, 5, o->handle.value, NULL);
+        }
+      if (isnew && nm)
+        free (nm);
+    }
+  return NULL;
+}
+
+static BITCODE_H
+cached_tablehandle (Dwg_Data *restrict dwg, const char *name, const char *table)
+{
+  size_t len = strlen (table) + strlen (name) + 2, i;
+  char *key = (char *)malloc (len);
+  BITCODE_H hdl;
+  if (!key)
+    return dwg_find_tablehandle_silent (dwg, name, table);
+  snprintf (key, len, "%s\x1f%s", table, name);
+  if (th_cap)
+    for (i = th_hash (key) & (th_cap - 1); th_slots[i].key; i = (i + 1) & (th_cap - 1))
+      if (!strcmp (th_slots[i].key, key))
+        {
+          free (key);
+          return th_slots[i].hdl;
+        }
+  hdl = dwg_find_tablehandle_silent (dwg, name, table);
+  if (!hdl && !strcmp (table, "BLOCK"))
+    hdl = block_by_name_scan (dwg, name);
+  if (2 * (th_n + 1) > th_cap)
+    {
+      size_t nc = th_cap ? 2 * th_cap : 1024;
+      TableHandleSlot *t = (TableHandleSlot *)calloc (nc, sizeof *t);
+      if (!t)
+        {
+          free (key);
+          return hdl;
+        }
+      for (size_t k = 0; k < th_cap; k++)
+        if (th_slots[k].key)
+          {
+            for (i = th_hash (th_slots[k].key) & (nc - 1); t[i].key; i = (i + 1) & (nc - 1))
+              ;
+            t[i] = th_slots[k];
+          }
+      free (th_slots);
+      th_slots = t, th_cap = nc;
+    }
+  for (i = th_hash (key) & (th_cap - 1); th_slots[i].key; i = (i + 1) & (th_cap - 1))
+    ;
+  th_slots[i].key = key, th_slots[i].hdl = hdl, th_n++;
+  return hdl;
+}
