+/* UNIMOG patch: a broken object costs only itself. LibreDWG gave up on the
+   whole file at the first object it could not read (an unknown group code
+   in a FIELD, a mesh vertex, ...): 1 in 4 public drawings saved as DXF.
+   The object is hidden (entities) and reading goes on at the next object. */
+static unsigned long dxf_broken_objects;
+EXPORT unsigned long
+dxf_broken_count (void)
+{
+  return dxf_broken_objects;
+}
+static Dxf_Pair *
+dxf_skip_broken (Bit_Chain *restrict dat, Dwg_Data *restrict dwg, BITCODE_BL idx)
+{
+  Dxf_Pair *pair;
+  dxf_broken_objects++;
+  if (idx < dwg->num_objects)
+    {
+      Dwg_Object *obj = &dwg->object[idx];
+      if (obj->supertype == DWG_SUPERTYPE_ENTITY && obj->tio.entity)
+        obj->tio.entity->invisible = 1;
+    }
+  while ((pair = dxf_read_pair (dat)) != NULL
+         && !(pair->code == 0 && pair->value.s.ptr))
+    dxf_free_pair (pair);
+  return pair;
+}
