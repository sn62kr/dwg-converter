+/* UNIMOG patch: the index of owner/pointer refs is a hash table (open
+   addressing in object_ordered_ref, its size derived from the count) instead
+   of a sorted array: inserting into the sorted array moved half of it every
+   time (minutes for a 58 MB DXF), and a duplicate switched it off for good.
+   Like before, a lookup returns the first ref added for (code, handle). */
+static size_t
+ref_hash_cap (BITCODE_BL n)
+{
+  size_t c = 1024;
+  while (c < 2 * (size_t)n + 2)
+    c <<= 1;
+  return c;
+}
+
+static size_t
+ref_hash_at (BITCODE_RC code, BITCODE_RLL absref, size_t cap)
+{
+  uint64_t h = (uint64_t)absref * 0x9E3779B97F4A7C15ULL ^ code;
+  h ^= h >> 29;
+  return (size_t)h & (cap - 1);
+}
