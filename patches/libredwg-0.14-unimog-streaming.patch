 /* R2004, 2010+ Handles Section
  */
+/* UNIMOG streaming patch (GPL-3.0, same license as LibreDWG).
+   When a callback is set, each freshly decoded object is offered to it.
+   If the callback returns non-zero it has consumed the object: the object's
+   data and its global handle refs are freed, its object_map entry is
+   invalidated and its slot in dwg->object is reused. This keeps peak memory
+   bounded by the non-consumed objects instead of the whole drawing. */
+static dwg_stream_cb stream_cb = NULL;
+static void *stream_ud = NULL;
+static int stream_have_last = 0;
+static BITCODE_RLL stream_last_handle = 0;
+static BITCODE_MC stream_last_size = 0;
+static unsigned long stream_consumed = 0;
+static int stream_active = 0;  // only inside the R2004+/R2007 object stream
+static int stream_pending = 0; // callback consumed the object being added
+
+EXPORT void
+dwg_set_stream_callback (dwg_stream_cb cb, void *userdata)
+{
+  stream_cb = cb;
+  stream_ud = userdata;
+  stream_have_last = 0;
+  stream_consumed = 0;
+}
+
+EXPORT unsigned long
+dwg_stream_consumed (void)
+{
+  return stream_consumed;
+}
+
+/* R2007 has its own handles loop in decode_r2007.c: it brackets that loop
+   with stream_r2007_begin/end and calls stream_consume after each object. */
+void
+stream_r2007_begin (void)
+{
+  stream_active = stream_cb != NULL;
+  stream_have_last = 0;
+  stream_pending = 0;
+}
+
+void
+stream_r2007_end (void)
+{
+  stream_active = 0;
+  stream_pending = 0;
+}
+
+void
+stream_consume (Dwg_Data *restrict dwg, BITCODE_BL nobj, BITCODE_BL nrefs)
+{
+  Dwg_Object *obj;
+  BITCODE_BL i;
+  int pending = stream_pending;
+  stream_pending = 0; // never let a decision leak into the next object
+  if (dwg->num_objects != nobj + 1)
+    return; // nothing added (skipped or error)
+  obj = &dwg->object[nobj];
+  if (!pending)
+    {
+      stream_have_last = 0;
+      return;
+    }
+  stream_have_last = 1;
+  stream_last_handle = obj->handle.value;
+  stream_last_size = obj->size;
+  dwg_free_object (obj);
+  for (i = nrefs; i < dwg->num_object_refs; i++)
+    {
+      free (dwg->object_ref[i]);
+      dwg->object_ref[i] = NULL;
+    }
+  dwg->num_object_refs = nrefs;
+  // never entered into object_map, see dwg_decode_add_object
+  memset (obj, 0, sizeof (Dwg_Object));
+  dwg->num_objects--;
+  stream_consumed++;
+}
